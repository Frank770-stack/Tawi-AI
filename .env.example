# MongoDB Atlas (a replica set: transactions are required).
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/tawi?retryWrites=true&w=majority"
# Separate database for automated tests. Tests WIPE this database.
TEST_DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/tawi_test?retryWrites=true&w=majority"

# "console" logs OTPs to the server console. "africastalking" sends real SMS.
SMS_MODE="console"
AFRICASTALKING_USERNAME="sandbox"
AFRICASTALKING_API_KEY=""
# Optional registered sender ID / shortcode
AFRICASTALKING_SENDER_ID=""

# Comma-separated phones (any Kenyan format) allowed to view /metrics
INTERNAL_PHONES=""
